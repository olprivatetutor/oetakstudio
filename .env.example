GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
AI_INPUT_COST_PER_MILLION_MICROS=0
AI_OUTPUT_COST_PER_MILLION_MICROS=0
