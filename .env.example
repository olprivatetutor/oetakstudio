# Development Environment Variables
# Copy this file to .env and modify as needed

# Database Configuration
# Owner/superuser connection used today by most app code (db/index.ts) and by
# drizzle-kit migrations unless MIGRATION_DATABASE_URL is set separately.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres
# Used by Docker Compose's application container. The hostname is the service name.
APP_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ADR-009: migrations must run as a role distinct from the RLS-restricted
# runtime role. Defaults to DATABASE_URL when unset.
# MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres

# ADR-009: non-owner, non-BYPASSRLS role used by db/runtime.ts (workspace/RBAC
# code only, for now). Created by drizzle/0012_rls_workspace_hardening.sql;
# set its password with `RUNTIME_DB_PASSWORD=... npm run db:setup-runtime-role`.
# RUNTIME_DATABASE_URL=postgresql://app_rw:<password>@localhost:5433/postgres
# RUNTIME_DB_PASSWORD=

# Authentication
BETTER_AUTH_SECRET=your_secret_key_here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Oetak <no-reply@example.com>
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL_MONTHLY=
STRIPE_PRICE_PERSONAL_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_SCHOOL_MONTHLY=
STRIPE_PRICE_SCHOOL_ANNUAL=
STRIPE_PRICE_UNIVERSITY_MONTHLY=
STRIPE_PRICE_UNIVERSITY_ANNUAL=
# AI Provider Configuration
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDERS=gemini,anthropic,deepseek
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=
