# Development Environment Variables
# Copy this file to .env and modify as needed

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres
# Used by Docker Compose's application container. The hostname is the service name.
APP_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Authentication
BETTER_AUTH_SECRET=your_secret_key_here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Oetak <no-reply@example.com>
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL_MONTHLY=
STRIPE_PRICE_PERSONAL_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_SCHOOL_MONTHLY=
STRIPE_PRICE_SCHOOL_ANNUAL=
STRIPE_PRICE_UNIVERSITY_MONTHLY=
STRIPE_PRICE_UNIVERSITY_ANNUAL=
# AI Provider Configuration
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDERS=gemini,anthropic,deepseek
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
AI_INPUT_COST_PER_MILLION_MICROS=0
AI_OUTPUT_COST_PER_MILLION_MICROS=0
STT_PROVIDER=deepgram
TTS_PROVIDER=elevenlabs
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
